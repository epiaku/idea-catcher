IDEAS_REPO=../idea-bucket
DOCS_REPO=../epiaku-docs
PROFILES_FILE=profiles.yaml
FREELLMAPI_URL=http://10.10.60.12:3001/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_API_KEY=not-needed
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI models (id: context, price per 1M input / output tokens), checked September 2026:
#   gpt-6-luna   1.05M   $0.10 / $0.50   cheap and fast, for short notes
#   gpt-6-sol    1.05M   $2 / $10        mid-tier, good for long chats and transcripts (our start)
#   gpt-6-astra  1.05M   $10 / $50       top tier, only if the mid-tier misses decisions
# Capabilities, context sizes and current model ids: https://developers.openai.com/api/docs/models
# Prices: https://developers.openai.com/api/docs/pricing
OPENAI_MODEL_CLIPPINGS=gpt-6-sol
OPENAI_MODEL_YOUTUBE=gpt-6-sol
LLM_TIMEOUT_S=600
# A call that fails with a 5xx, a timeout or a dropped connection is tried again: this many calls in all
# (1 turns it off), waiting 2s, 4s, 8s... between them. FreeLLMApi picks a provider per call, so a retry often works.
LLM_MAX_ATTEMPTS=5
LLM_RETRY_WAIT_S=2
# A document longer than this (characters, with its YouTube facts) fails without an LLM call
# LLM_MAX_INPUT_CHARS=400000
# Every LLM call of a run leaves a trace (the replies, tokens, outcome) in llm/ of the idea-bucket
# LLM_TRACE=true
# Also save the full prompt in each trace (large: it holds the whole document)
# LLM_TRACE_PROMPT=false
# A run first reads a saved good reply in llm/ (same task, profile, prompt version and document text)
# instead of calling the model. false: always call. To refresh one run: catcher run pipeline --refresh-llm
# LLM_CACHE=true
# Worker: after a "backend unavailable" error (down or a timeout, a rate or usage limit, a wrong key or another
# refused request, a missing API key) that backend is not called for this many seconds: the next documents
# are deferred without a call, then one tries it again. A model the backend does not know (an HTTP 400/404 that
# says so) blocks only that profile, for the same time. Kept in Postgres (`resources`): a restart keeps it
# LLM_BLOCK_S=600
# Worker: a backend whose budget is used up is not called for this many seconds (6 hours)
# LLM_BUDGET_BLOCK_S=21600
# Worker: an item `deferred` for this many days becomes `stuck` (a warning; retry_deferred still retries it)
# STUCK_AFTER_DAYS=3
TRANSCRIPT_LANGUAGES=en
# YouTube: a ban is per IP and about request rate. Go slowly, and stop when YouTube says no.
YOUTUBE_REQUEST_DELAY_S=10
YOUTUBE_MIN_GAP_S=120
YOUTUBE_GAP_JITTER_S=300
# Hours without calls after a block, doubled each time up to 24. More than 0 and at most 24
YOUTUBE_BLOCK_HOURS=6
# YOUTUBE_OFFLINE=1
# YOUTUBE_SKIP_MANIFESTS=1
# YOUTUBE_WAIT_MAX_S=1800
# YOUTUBE_NEGATIVE_TTL_H=24
# Worker schedules (cron, five fields; empty = off). The worker (not --once) queues the job on each slot;
# a missed slot runs once. Show them with: catcher schedules
# SCHEDULE_IDEAS_PULL="*/30 * * * *"           # ideas.pull: pull idea-bucket often (new captures)
# SCHEDULE_PIPELINE_RUN="0 8,12,17,21 * * *"   # pipeline.run with retry_deferred: process the inbox
# SCHEDULE_PUBLISH="0 6,12,18,23 * * *"        # pipeline.publish with pull and push: commit + push
# SCHEDULE_TIMEZONE=Europe/Amsterdam           # the times above are wall-clock times here
# SCHEDULE_TICK_S=30                           # seconds between two checks for a due slot
GIT_AUTHOR_NAME=idea-catcher
GIT_AUTHOR_EMAIL=idea-catcher@users.noreply.github.com
# Files in inbox/ that are not markdown (PDFs, images) are copied to epiaku-docs; larger ones are skipped.
ARTIFACT_MAX_MB=25
# The queue database (Postgres 17 with pgvector)
DATABASE_URL=postgresql+psycopg://catcher:catcher@localhost:5432/catcher
LOG_LEVEL=INFO
# LOG_FILE=logs/catcher.log
