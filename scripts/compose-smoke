#!/usr/bin/env bash
# A real compose run of the worker and the API on throwaway copies: proves the worker clones, pulls, runs, publishes
# and stops cleanly, and the API answers with its keys, enqueues runs and holds no token (step j).
#   bash scripts/compose-smoke     about 8 minutes; needs Docker; no GitHub, no LLM, no YouTube
# Everything it makes has its own name (project catcher-smoke-<n>, image idea-catcher:smoke-<n>, a temp dir)
# and is removed at the end, also on failure or Ctrl-C. It never touches tests/data, tmp/ic, ~/.catcher,
# the host .env, or another compose project (such as a catcher-db on port 5432).
# Prints PASS/FAIL per step; exits 1 when any step failed.
#   bash scripts/compose-smoke --selftest   only checks the assertion logic on sample outputs (no Docker)
# Not covered: `docker compose stop` while a long job runs (the grace period letting it finish). The smoke stop
# hits an idle worker (it proves SIGTERM reaches the exec'd PID 1, exit 0, within the grace); the runner's own
# tests cover finishing the current job.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

TYPES=(ideas.pull pipeline.run pipeline.publish)

# --- pure checks (no Docker): also run by --selftest on sample input
has() {  # grep -q in a pipe ends early; the writer's SIGPIPE fails the pipe under pipefail: read it all first
  local text
  text="$(cat)"
  grep -qE -- "$1" <<<"$text"
}
schedules_fired_in() {  # $1: `catcher schedules` output; every schedule on, with a date under `last fired`
  local name
  for name in ideas_pull pipeline_run publish; do
    # name, five cron fields, timezone, last fired (date time | never), next due
    awk -v n="$name" '$1 == n && $2 != "off" && $8 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/' <<<"$1" \
      | has . || return 1
  done
}
new_in_window() {  # $1: "type epoch" lines (jobs created_at), $2 type, $3 from (incl), $4 to (excl): the count
  awk -v t="$2" -v a="$3" -v b="$4" '$1 == t && $2 >= a && $2 < b {n++} END {print n + 0}' <<<"$1"
}
first_new() {  # $1 created list, $2 type, $3 epoch: the first created_at of that type after it (empty: none)
  awk -v t="$2" -v a="$3" '$1 == t && $2 > a && (m == "" || $2 < m) {m = $2} END {print m}' <<<"$1"
}
# The scheduler ticks every SCHEDULE_TICK_S (30 s): all catch-ups of one restart are queued in ONE tick, so a
# flood shows as two or more jobs of one type within seconds of the first new one; the next regular slot comes
# at least one tick later. Only created_at values (one clock, the db container's) are compared.
CATCH_UP_WINDOW_S=15
one_catch_up_each() {  # $1 created list, $2 epoch the worker stopped: exactly one job per type in the first tick
  local type first n ok=0
  for type in "${TYPES[@]}"; do
    first="$(first_new "$1" "$type" "$2")"
    n=0
    [ -z "$first" ] || n="$(new_in_window "$1" "$type" "$first" $((first + CATCH_UP_WINDOW_S)))"
    echo "  $type: $n job(s) queued in the first ${CATCH_UP_WINDOW_S} s after the restart (the catch-up)"
    [ "$n" -eq 1 ] || ok=1
  done
  return "$ok"
}
next_slot_fired() {  # $1 created list, $2 epoch the worker stopped: a later regular job of each type too
  local type first
  for type in "${TYPES[@]}"; do
    first="$(first_new "$1" "$type" "$2")"
    [ -n "$first" ] && [ "$(new_in_window "$1" "$type" $((first + CATCH_UP_WINDOW_S)) 99999999999)" -ge 1 ] \
      || return 1
  done
}
clean_of() {  # clean_of <needle> <marker>: stdin has the marker (so it is real output) and not the needle
  local text
  text="$(cat)"
  grep -qF -- "$2" <<<"$text" && ! grep -qF -- "$1" <<<"$text"
}
json_field() {  # json_field <name> < JSON object: the field's value (a string as is, others as JSON); fails on bad JSON
  python3 -c 'import json, sys
v = json.load(sys.stdin)[sys.argv[1]]
print(v if isinstance(v, str) else json.dumps(v))' "$1" 2>/dev/null
}
job_types_in() {  # stdin: a /api/v1/jobs page; the type of every job on it, one per line
  python3 -c 'import json, sys
for job in json.load(sys.stdin)["items"]:
    print(job["type"])' 2>/dev/null
}
all_types_in() {  # $1: types, one per line; every scheduled type is among them
  local type
  for type in "${TYPES[@]}"; do grep -qx -- "$type" <<<"$1" || return 1; done
}
API_ENV_NAMES="API_KEYS DATABASE_URL LOG_LEVEL"
api_env_ok() {  # $1: `env` in the api container, $2: the image's own env; compose added exactly the three
  local added
  # The settings the api must never hold, by name (also when empty).
  ! grep -qE '^(GITHUB_TOKEN|OPENAI_[A-Z_]*|FREELLMAPI_[A-Z_]*|IDEAS_[A-Z_]*|DOCS_[A-Z_]*|DB_PASSWORD)=' <<<"$1" \
    || return 1
  # Names compose added: not in the image config, and not the two Docker sets itself (HOSTNAME, HOME).
  added="$(cut -d= -f1 <<<"$1" | grep -vxF -f <(cut -d= -f1 <<<"$2"; printf 'HOSTNAME\nHOME\n') | sort | xargs)"
  echo "  names compose added to the api container: $added"
  [ "$added" = "$API_ENV_NAMES" ]
}

if [ "${1:-}" = --selftest ]; then
  bad=0
  expect() {  # expect <0|1> <name> <command...>
    local want="$1" name="$2" got=0
    shift 2
    "$@" >/dev/null || got=1
    if [ "$got" = "$want" ]; then echo "ok   $name"; else echo "BAD  $name (got $got, want $want)"; bad=1; fi
  }
  fired=$'name          cron       timezone  last fired        next due
ideas_pull    * * * * *  UTC       2026-10-07 18:47  2026-10-07 18:48
pipeline_run  * * * * *  UTC       2026-10-07 18:47  2026-10-07 18:48
publish       * * * * *  UTC       2026-10-07 18:47  2026-10-07 18:48'
  expect 0 "schedules: all three fired" schedules_fired_in "$fired"
  expect 1 "schedules: one never fired" schedules_fired_in "${fired/publish       * * * * *  UTC       2026-10-07 18:47/publish       * * * * *  UTC       never}"
  expect 1 "schedules: one missing" schedules_fired_in "$(grep -v ^pipeline_run <<<"$fired")"
  expect 1 "schedules: one off" schedules_fired_in "${fired/ideas_pull    * * * * *  UTC       2026-10-07 18:47  2026-10-07 18:48/ideas_pull    off  -  -  -}"
  # stopped at 950 (sample numbers): catch-up at 1004, the next regular slot at 1021
  old=$'ideas.pull 900\npipeline.run 900\npipeline.publish 900'
  catch=$'ideas.pull 1004\npipeline.run 1004\npipeline.publish 1005'
  once="$catch"$'\nideas.pull 1021\npipeline.run 1021\npipeline.publish 1021'
  expect 0 "one catch-up each" one_catch_up_each "$old"$'\n'"$once" 950
  expect 1 "a flood (two catch-ups of one type)" one_catch_up_each "$old"$'\n'"$once"$'\npipeline.run 1006' 950
  expect 1 "a flood (four of each)" one_catch_up_each "$catch"$'\n'"$catch"$'\n'"$catch"$'\n'"$catch" 950
  expect 1 "no catch-up at all" one_catch_up_each "$old" 950
  expect 0 "the next slot fired" next_slot_fired "$once" 950
  expect 1 "the next slot did not fire" next_slot_fired "$old"$'\n'"$catch" 950
  expect 0 "clean_of: marker, no token" clean_of secret marker <<<"a marker line"
  expect 1 "clean_of: token present" clean_of secret marker <<<"marker and secret"
  expect 1 "clean_of: empty input" clean_of secret marker </dev/null
  expect 0 "json_field: a string" test "$(json_field job_id <<<'{"job_id": "ab-1", "existing": true}')" = ab-1
  expect 0 "json_field: a bool as JSON" test "$(json_field existing <<<'{"job_id": "ab-1", "existing": true}')" = true
  expect 1 "json_field: missing field" json_field job_id <<<'{"detail": "Not authenticated"}'
  expect 1 "json_field: not JSON" json_field job_id <<<'Internal Server Error'
  page='{"items": [{"type": "ideas.pull"}, {"type": "pipeline.run"}, {"type": "pipeline.publish"}], "total": 3}'
  expect 0 "jobs page: all three types" all_types_in "$(job_types_in <<<"$page")"
  expect 1 "jobs page: publish missing" all_types_in "$(job_types_in <<<"${page/pipeline.publish/ideas.pull}")"
  expect 1 "jobs page: empty" all_types_in "$(job_types_in <<<'{"items": [], "total": 0}')"
  expect 1 "jobs page: not JSON" all_types_in "$(job_types_in <<<'oops')"
  image_env=$'PATH=/app/.venv/bin:/usr/bin\nLANG=C.UTF-8\nGIT_ASKPASS=/usr/local/bin/git-askpass'
  api_env="$image_env"$'\nHOSTNAME=abc\nHOME=/home/catcher\nDATABASE_URL=postgresql+psycopg://x\nAPI_KEYS=k\nLOG_LEVEL=INFO'
  expect 0 "api env: exactly the three" api_env_ok "$api_env" "$image_env"
  expect 1 "api env: a GITHUB_TOKEN (empty)" api_env_ok "$api_env"$'\nGITHUB_TOKEN=' "$image_env"
  expect 1 "api env: an OpenAI key" api_env_ok "$api_env"$'\nOPENAI_API_KEY=sk' "$image_env"
  expect 1 "api env: a repo path" api_env_ok "$api_env"$'\nIDEAS_REPO=/data/repos/idea-bucket' "$image_env"
  expect 1 "api env: another added name" api_env_ok "$api_env"$'\nPROFILES_FILE=profiles.yaml' "$image_env"
  expect 1 "api env: API_KEYS missing" api_env_ok "$(grep -v ^API_KEYS <<<"$api_env")" "$image_env"
  expect 1 "api env: empty" api_env_ok "" "$image_env"
  [ "$bad" = 0 ] && echo "selftest passed" || echo "selftest FAILED"
  exit "$bad"
fi

ID="$$-$RANDOM"
PROJECT="catcher-smoke-$ID"
export SMOKE_IMAGE="idea-catcher:smoke-$ID"
export SMOKE_GITHUB_TOKEN="smoke-token-not-real"  # a dummy: it must never show up in a log or a .git/config
SMOKE_API_KEY="smoke-api-key-not-real-0000"  # a dummy API key: never printed, never in a log or the image
export SMOKE_API_KEYS="smoke:read,run:$SMOKE_API_KEY"
TMP_BASE="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
TMP="$(cd "$(mktemp -d "$TMP_BASE/catcher-smoke.XXXXXX")" && pwd -P)"
export SMOKE_REMOTES="$TMP/remotes"
: >"$TMP/empty.env"  # compose reads this instead of the project .env for ${...}

free_port() {
  python3 - <<'EOF'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
EOF
}
DB_PORT="$(free_port)"
while [ "$DB_PORT" = 5432 ]; do DB_PORT="$(free_port)"; done
export DB_PORT
API_PORT="$(free_port)"
while [ "$API_PORT" = 5432 ] || [ "$API_PORT" = "$DB_PORT" ]; do API_PORT="$(free_port)"; done
export API_PORT

dc() { docker compose -p "$PROJECT" --env-file "$TMP/empty.env" -f compose.yaml -f compose.test.yaml "$@"; }
wexec() { dc exec -T worker "$@"; }

FAILS=0
pass() { echo "PASS $*"; }
fail() {
  echo "FAIL $*"
  FAILS=$((FAILS + 1))
}
check() {  # check "<name>" <command...>: PASS when the command succeeds
  local name="$1"
  shift
  if "$@"; then pass "$name"; else fail "$name"; fi
}
now() { date +%s; }
log() { echo "[$(date '+%H:%M:%S')] $*"; }

MONITOR_PID=""
teardown() {
  local rc=$?
  trap '' INT TERM  # a second Ctrl-C must not stop the teardown halfway
  set +e
  [ -n "$MONITOR_PID" ] && kill "$MONITOR_PID" 2>/dev/null
  log "teardown: compose project $PROJECT (down -v), image $SMOKE_IMAGE, temp dir $TMP"
  if [ "${SMOKE_DEBUG:-}" = 1 ]; then dc logs --no-color --tail 80 >&2; fi
  dc down -v --remove-orphans --timeout 30 >/dev/null 2>&1
  docker image rm "$SMOKE_IMAGE" >/dev/null 2>&1
  case "$TMP" in
    "$TMP_BASE"/catcher-smoke.?*) rm -rf "$TMP" ;;
    *) echo "teardown: not removing unexpected temp path '$TMP'" ;;
  esac
  local left
  left="$(docker ps -a --filter "label=com.docker.compose.project=$PROJECT" -q)"
  left+="$(docker volume ls --filter "label=com.docker.compose.project=$PROJECT" -q)"
  left+="$(docker network ls --filter "label=com.docker.compose.project=$PROJECT" -q)"
  left+="$(docker image ls -q "$SMOKE_IMAGE")"
  if [ -n "$left" ]; then
    echo "FAIL teardown: something of $PROJECT is left: $left"
    rc=1
  else
    echo "PASS teardown: no container, volume, network or image of $PROJECT is left"
  fi
  exit "$rc"
}
trap teardown EXIT
trap 'exit 130' INT TERM

log "project $PROJECT, db port $DB_PORT, api port $API_PORT, image $SMOKE_IMAGE, temp $TMP"

# --- the throwaway remotes: bare copies of the test data, writable for the container user (uid 1000)
git_clean() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -c user.name=smoke -c user.email=smoke@example.com "$@"; }
uv run --quiet catcher testdata reset --target "$TMP/ic" >/dev/null
mkdir -p "$SMOKE_REMOTES"
for name in idea-bucket epiaku-docs; do
  git_clean clone -q --bare "$TMP/ic/$name" "$SMOKE_REMOTES/$name.git"
  git_clean -C "$SMOKE_REMOTES/$name.git" config core.sharedRepository world
done
chmod -R a+rwX "$SMOKE_REMOTES"

# --- (a) build and start; migrate exits 0; the worker becomes healthy, never unhealthy
START="$(now)"
log "building and starting (the first build takes a few minutes)"
if ! dc up -d --build --quiet-pull >"$TMP/up.log" 2>&1; then
  tail -n 30 "$TMP/up.log"
  fail "(a) docker compose up"
  dc logs --no-color migrate worker 2>&1 | tail -n 30
  exit 1
fi
UP="$(now)"
log "up after $((UP - START)) s"

MIGRATE_ID="$(dc ps -a -q migrate)"
WORKER_ID="$(dc ps -a -q worker)"
check "(a) migrate exited 0" test "$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "$MIGRATE_ID")" = "exited 0"

# Watch the health status in the background for the whole run (only while the container runs).
(
  while true; do
    docker inspect -f '{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$WORKER_ID" \
      2>/dev/null | sed "s/^/$(date +%s) /"
    sleep 5
  done
) >"$TMP/health.log" &
MONITOR_PID=$!

wait_healthy() {  # wait_healthy <seconds> [container id, default the worker]
  local deadline=$(($(now) + $1)) status
  while [ "$(now)" -lt "$deadline" ]; do
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${2:-$WORKER_ID}")"
    [ "$status" = healthy ] && return 0
    sleep 3
  done
  return 1
}
if wait_healthy 180; then
  HEALTHY="$(now)"
  pass "(a) the worker is healthy, $((HEALTHY - UP)) s after up ($((HEALTHY - START)) s with the build)"
else
  fail "(a) the worker did not become healthy within 180 s"
  dc logs --no-color worker | tail -n 30
fi
log "image size: $(docker image inspect -f '{{.Size}}' "$SMOKE_IMAGE" | awk '{printf "%.0f MB", $1 / 1000000}')"

# --- (b) both repos were cloned into the volume
for name in idea-bucket epiaku-docs; do
  check "(b) $name cloned into the repos volume" wexec git -C "/data/repos/$name" log -1 --format='%h %s'
done

# --- (d, first half) a capture pushed into the bare idea-bucket remote from another clone (the phone)
CAPTURE="inbox/smoke-capture-$ID.md"
git_clean clone -q "$SMOKE_REMOTES/idea-bucket.git" "$TMP/phone"
mkdir -p "$TMP/phone/inbox"
printf '# Smoke capture %s\n\nA note pushed from another clone while the worker runs.\n' "$ID" >"$TMP/phone/$CAPTURE"
git_clean -C "$TMP/phone" add "$CAPTURE"
git_clean -C "$TMP/phone" commit -qm "smoke capture $ID"
git_clean -C "$TMP/phone" push -q origin HEAD
CAPTURE_SHA="$(git_clean -C "$TMP/phone" rev-parse HEAD)"
log "pushed capture $CAPTURE_SHA to the bare idea-bucket remote"

# --- (c) within ~150 s a job of each scheduled type and all three schedules fired
jobs_seen() {
  local list type
  list="$(wexec catcher jobs list --limit 500 2>/dev/null)" || return 1
  for type in ideas.pull pipeline.run pipeline.publish; do
    awk -v t="$type" '$2 == t' <<<"$list" | has . || return 1
  done
}
deadline=$(($(now) + 150))
until jobs_seen || [ "$(now)" -ge "$deadline" ]; do sleep 5; done
check "(c) jobs list shows ideas.pull, pipeline.run and pipeline.publish" jobs_seen
SCHEDULES="$(wexec catcher schedules)"
echo "$SCHEDULES"
check "(c) schedules: all three have a last fired" schedules_fired_in "$SCHEDULES"

# --- (d) the capture arrives in the container's clone (pulled by the schedule), and publish pushed back
capture_arrived() { wexec git -C /data/repos/idea-bucket merge-base --is-ancestor "$CAPTURE_SHA" HEAD 2>/dev/null; }
deadline=$(($(now) + 150))
until capture_arrived || [ "$(now)" -ge "$deadline" ]; do sleep 5; done
check "(d) the pushed capture arrived in the container's idea-bucket clone" capture_arrived
published() {
  git_clean -C "$SMOKE_REMOTES/idea-bucket.git" log --format='%an' main | has '^idea-catcher-smoke$'
}
deadline=$(($(now) + 150))
until published || [ "$(now)" -ge "$deadline" ]; do sleep 5; done
check "(d) a worker commit was pushed to the bare idea-bucket remote (publish)" published
no_push_error() {
  local logs
  logs="$(dc logs --no-color worker 2>&1)" || return 1
  grep -q "publish: committed=" <<<"$logs" && ! grep -q "push failed" <<<"$logs"
}
check "(d) the log has publish lines and no 'push failed'" no_push_error
if [ "$FAILS" -gt 0 ]; then  # what publish did, for the report
  dc logs --no-color worker 2>&1 | grep -E "publish|ERROR" | tail -n 12
  for name in idea-bucket epiaku-docs; do
    echo "bare $name:"
    git_clean -C "$SMOKE_REMOTES/$name.git" log --format='  %h %an: %s' -3 main
    echo "container $name:"
    wexec git -C "/data/repos/$name" log --format='  %h %an: %s' -3
    wexec git -C "/data/repos/$name" status -sb | head -n 3
  done
fi

JOBS_LIST="$(wexec catcher jobs list --limit 500)"
no_failed_jobs() { ! awk '$3 == "failed"' <<<"$JOBS_LIST" | has .; }
check "(c) no job failed" no_failed_jobs
awk '$3 == "failed"' <<<"$JOBS_LIST" | head -n 5

# --- (h) a pipeline run by hand inside the running container refuses: one worker at a time
rc=0
out="$(wexec catcher run pipeline 2>&1)" || rc=$?
echo "$out" | tail -n 2
busy_refused() { [ "$rc" = 2 ] && grep -q "another worker or run is already running" <<<"$out"; }
check "(h) catcher run pipeline in the worker container exits 2 with the one-worker message (rc=$rc)" busy_refused

# --- (g) the dummy token is nowhere it must not be
# Each grep also needs a marker known to be in that output, so an empty or failed output cannot pass.
T="$SMOKE_GITHUB_TOKEN"
WENV="$(wexec env)" || WENV=""
token_in_env() { grep -qx "GITHUB_TOKEN=$T" <<<"$WENV"; }
check "(g) the worker env has GITHUB_TOKEN=$T (so the greps below look for something real)" token_in_env
only_in_github_token() { [ "$(grep -cF -- "$T" <<<"$WENV")" = 1 ]; }
check "(g) the worker env holds the token only in GITHUB_TOKEN (for askpass)" only_in_github_token
check "(g) no token in the compose logs" clean_of "$T" "worker " < <(dc logs --no-color 2>&1)
check "(g) no token in docker history" clean_of "$T" "docker-entrypoint" < <(docker history --no-trunc "$SMOKE_IMAGE")
check "(g) no token in the image config" clean_of "$T" "GIT_ASKPASS" < <(docker image inspect "$SMOKE_IMAGE")
for name in idea-bucket epiaku-docs; do
  check "(g) no token in $name .git/config or git config --list" clean_of "$T" "/remotes/$name.git" \
    < <(wexec sh -c "cat /data/repos/$name/.git/config; git -C /data/repos/$name config --list --show-origin")
done

# --- (j) the API container: health, keys, reads, triggers, least privilege. Every call goes to the published
# port on 127.0.0.1; the key travels in a header file (curl -H @file), never on a command line or in the output.
API_URL="http://127.0.0.1:$API_PORT"
printf 'Authorization: Bearer %s\n' "$SMOKE_API_KEY" >"$TMP/key.h"
printf 'Authorization: Bearer %s\n' "smoke-api-key-not-real-9999" >"$TMP/wrong.h"
call() {  # call <key|wrong|none> <GET|POST> <path>: prints the HTTP status; the body lands in $TMP/body.json
  local header=/dev/null
  case "$1" in key) header="$TMP/key.h" ;; wrong) header="$TMP/wrong.h" ;; esac
  if [ "$2" = POST ]; then
    curl -s -m 10 -o "$TMP/body.json" -w '%{http_code}' -H "@$header" -H 'Content-Type: application/json' \
      -X POST -d '{}' "$API_URL$3"
  else
    curl -s -m 10 -o "$TMP/body.json" -w '%{http_code}' -H "@$header" "$API_URL$3"
  fi
}
body() { cat "$TMP/body.json" 2>/dev/null; }
API_ID="$(dc ps -a -q api)"
if wait_healthy 120 "$API_ID"; then pass "(j) the api container is healthy"; else
  fail "(j) the api container did not become healthy within 120 s"
  dc logs --no-color api | tail -n 20
fi
check "(j) the api port is published on 127.0.0.1 only ($(dc port api 8000))" \
  test "$(dc port api 8000)" = "127.0.0.1:$API_PORT"
health_is() {  # health_is <code> <worker>: /health answers that code and names the worker that way
  [ "$(call none GET /health)" = "$1" ] && [ "$(body | json_field worker)" = "$2" ] \
    && [ "$(body | json_field database)" = ok ]
}
deadline=$(($(now) + 60))
until health_is 200 running || [ "$(now)" -ge "$deadline" ]; do sleep 3; done
check "(j) /health is 200 with the worker running ($(body))" health_is 200 running
check "(j) no key: 401" test "$(call none GET /api/v1/jobs)" = 401
check "(j) a wrong key: 401" test "$(call wrong GET /api/v1/jobs)" = 401
check "(j) a wrong key on a trigger: 401" test "$(call wrong POST /api/v1/pipeline/runs)" = 401
code="$(call key GET '/api/v1/jobs?limit=200')"
API_TYPES="$(body | job_types_in)"
echo "  GET /api/v1/jobs: $code, total $(body | json_field total), types: $(sort -u <<<"$API_TYPES" | xargs)"
check "(j) GET /api/v1/jobs with the key is 200 and lists ideas.pull, pipeline.run and pipeline.publish" \
  all_types_in "$API_TYPES"
code1="$(call key POST /api/v1/pipeline/runs)"
id1="$(body | json_field job_id)" || id1=""
code2="$(call key POST /api/v1/pipeline/runs)"
id2="$(body | json_field job_id)" || id2=""
existing2="$(body | json_field existing)" || existing2=""
echo "  POST /api/v1/pipeline/runs twice: $code1 $id1, then $code2 $id2 (existing $existing2)"
first_ok() { case "$code1" in 200 | 202) [ -n "$id1" ] ;; *) return 1 ;; esac; }
check "(j) the first POST /api/v1/pipeline/runs is 202 or 200 (a scheduled run queued) with a job_id" first_ok
check "(j) the second POST at once is 200, existing, with the same job_id" \
  test "$code2 $existing2 $id2" = "200 true $id1"
job_ok() { [ "$(call key GET "/api/v1/jobs/$id1")" = 200 ] && [ "$(body | json_field id)" = "$id1" ] \
  && [ "$(body | json_field type)" = pipeline.run ]; }
check "(j) GET /api/v1/jobs/<that id> is 200 with that pipeline.run" job_ok
AENV="$(dc exec -T api env)" || AENV=""
IENV="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$SMOKE_IMAGE")"
key_in_env() { grep -qx "API_KEYS=$SMOKE_API_KEYS" <<<"$AENV"; }
check "(j) the api env has API_KEYS (the dummy; the greps below look at real output)" key_in_env
check "(j) the api env: no GITHUB_TOKEN, no LLM key, no repo variable; compose added only $API_ENV_NAMES" \
  api_env_ok "$AENV" "$IENV"
rc=0
dc run --rm --no-deps -T -e API_KEYS= api >"$TMP/nokey.log" 2>&1 || rc=$?
tail -n 2 "$TMP/nokey.log" | sed 's/^/    /'
no_key_refused() { [ "$rc" = 2 ] && grep -q API_KEYS "$TMP/nokey.log"; }
check "(j) the api without API_KEYS exits 2 before it listens, naming API_KEYS (rc=$rc)" no_key_refused

# --- (e) stop ends within the grace period with exit code 0 and logs `worker ... stopped`
before_stop="$(wexec catcher jobs list --limit 1000 | awk '{print $2}' | sort | uniq -c)"
dbnow() { dc exec -T db date +%s; }  # the containers' clock (Docker's VM can drift from the Mac's)
t0="$(now)"
dc stop worker >/dev/null 2>&1
STOP_S=$(($(now) - t0))
TSTOP="$(dbnow)"
check "(e) docker compose stop worker took $STOP_S s (grace 120 s)" test "$STOP_S" -lt 120
check "(e) the worker exited with code 0" test "$(docker inspect -f '{{.State.ExitCode}}' "$WORKER_ID")" = 0
stopped_logged() { dc logs --no-color worker 2>&1 | has "worker .+ stopped"; }
check "(e) the log has 'worker ... stopped'" stopped_logged

# --- (j) with the worker stopped the API still answers: /health 503 naming the worker, the rest as before
deadline=$(($(now) + 60))
until health_is 503 none || [ "$(now)" -ge "$deadline" ]; do sleep 3; done
check "(j) worker stopped: /health is 503 with \"worker\": \"none\" ($(body))" health_is 503 none
check "(j) worker stopped: GET /api/v1/jobs with the key is still 200" test "$(call key GET /api/v1/jobs)" = 200
check "(j) worker stopped: no key is still 401" test "$(call none GET /api/v1/jobs)" = 401
API_HEALTH_CMD="$(docker inspect -f '{{index .Config.Healthcheck.Test 1}}' "$API_ID")"
check "(j) worker stopped: the api healthcheck command (from the container config) still exits 0" \
  dc exec -T api sh -c "$API_HEALTH_CMD"

# --- (f) a restart keeps the repos and the jobs, and the missed slots fire ONCE (one catch-up, not a flood)
# Stopped >= 250 s: at least four slots are missed, so a flood would show as several jobs of one type at once.
# Restart early in a minute (second 5-30, db clock) so the catch-up lands well before the next slot.
log "worker stopped; waiting at least 250 s so at least four slots are missed"
while :; do
  t="$(dbnow)"
  [ "$t" -ge $((TSTOP + 250)) ] && [ $((t % 60)) -ge 5 ] && [ $((t % 60)) -le 30 ] && break
  sleep 2
done
created() {  # "type epoch" per job, read from the smoke project's own db container
  dc exec -T db psql -U catcher -d catcher -At -F ' ' -c \
    "select type, floor(extract(epoch from created_at))::bigint from jobs" 2>/dev/null
}
api_status() { docker inspect -f '{{.State.Health.Status}} restarts={{.RestartCount}}' "$API_ID"; }
check "(j) after $(($(dbnow) - TSTOP)) s without a worker the api is still healthy ($(api_status))" \
  test "$(api_status)" = "healthy restarts=0"
t1="$(dbnow)"
boundary=$(((t1 / 60 + 1) * 60))
log "restarting the worker (db clock $t1, host clock $(now), stopped since db clock $TSTOP)"
dc up -d worker >/dev/null 2>&1
if wait_healthy 120; then pass "(f) healthy again after $(($(dbnow) - t1)) s"; else fail "(f) not healthy again"; fi
check "(f) idea-bucket clone still there with the capture" capture_arrived
no_second_clone() { [ "$(dc logs --no-color worker 2>&1 | grep -c "Cloning into '/data/repos/idea-bucket'")" -le 1 ]; }
check "(f) the restart did not clone again" no_second_clone
after="$(wexec catcher jobs list --limit 1000 | awk '{print $2}' | sort | uniq -c)"
kept() { while read -r n type; do
  m="$(awk -v t="$type" '$2 == t {print $1}' <<<"$after")"
  [ "${m:-0}" -ge "$n" ] || return 1
done <<<"$before_stop"; }
check "(f) every job from before the stop is still there" kept
# Wait until the first regular slot after the restart has fired too, then count from the database.
until [ "$(dbnow)" -ge $((boundary + 40)) ]; do sleep 3; done
CREATED="$(created)"
check "(f) exactly one catch-up job per schedule after the restart (not a flood)" one_catch_up_each "$CREATED" "$TSTOP"
check "(f) the next regular slot fired for each schedule" next_slot_fired "$CREATED" "$TSTOP"

# --- (i) by hand inside the stack, as the how-to documents: stop the worker, `docker compose run --rm worker catcher
# ...` (same environment, the same repos volume; the entrypoint finds the clones), start the worker again.
# Stop well after the minute's tick (second 30-50), so no scheduled pipeline job is still queued: a by-hand run
# refuses then (exit 2, "an earlier run's job is still queued").
until t="$(dbnow)" && [ $((t % 60)) -ge 30 ] && [ $((t % 60)) -le 50 ]; do sleep 2; done
dc stop worker >/dev/null 2>&1
printf '# Smoke capture two %s\n\nPushed while the worker was stopped, for the by-hand run.\n' "$ID" \
  >"$TMP/phone/inbox/smoke-capture-two-$ID.md"
git_clean -C "$TMP/phone" pull -q --rebase origin main
git_clean -C "$TMP/phone" add "inbox/smoke-capture-two-$ID.md"
git_clean -C "$TMP/phone" commit -qm "smoke capture two $ID"
git_clean -C "$TMP/phone" push -q origin HEAD
CAPTURE2_SHA="$(git_clean -C "$TMP/phone" rev-parse HEAD)"
log "worker stopped; pushed capture two $CAPTURE2_SHA; running by hand with docker compose run --rm worker"
by_hand() {  # by_hand <log name> <catcher args...>: docker compose run --rm worker catcher ..., exit code kept
  local name="$1" rc=0
  shift
  dc run --rm -T worker catcher "$@" >"$TMP/$name.log" 2>&1 || rc=$?
  tail -n 3 "$TMP/$name.log" | sed 's/^/    /'
  return "$rc"
}
check "(i) docker compose run --rm worker catcher publish --push exits 0 (pulls capture two)" \
  by_hand publish1 publish --push
in_volume_clone() { dc run --rm -T worker git -C /data/repos/idea-bucket merge-base --is-ancestor "$1" HEAD >/dev/null 2>&1; }
check "(i) capture two is in the volume's clone" in_volume_clone "$CAPTURE2_SHA"
BARE_BEFORE_RUN="$(git_clean -C "$SMOKE_REMOTES/idea-bucket.git" rev-parse main)"
check "(i) docker compose run --rm worker catcher run pipeline exits 0 (offline: the capture defers)" \
  by_hand run1 run pipeline
check "(i) docker compose run --rm worker catcher publish --push exits 0" by_hand publish2 publish --push
pushed_by_hand() {  # the run's commit reached the remote: main moved since the first publish, worker-authored
  [ "$(git_clean -C "$SMOKE_REMOTES/idea-bucket.git" rev-parse main)" != "$BARE_BEFORE_RUN" ] \
    && [ "$(git_clean -C "$SMOKE_REMOTES/idea-bucket.git" log -1 --format=%an main)" = idea-catcher-smoke ]
}
check "(i) the by-hand run's commit was pushed to the bare idea-bucket remote (main moved)" pushed_by_hand
no_run_left() { [ -z "$(docker ps -a -q --filter "label=com.docker.compose.project=$PROJECT" \
  --filter "label=com.docker.compose.oneoff=True")" ]; }
check "(i) no one-off container is left (--rm)" no_run_left
t3="$(now)"
dc up -d worker >/dev/null 2>&1
if wait_healthy 120; then pass "(i) the worker is healthy again after $(($(now) - t3)) s"; else fail "(i) not healthy again"; fi

# --- (j) the dummy API key is in no log and not in the image. It IS in the api container's env and its
# `docker inspect` (Config.Env): that is how compose hands it over, by design.
K="$SMOKE_API_KEY"
for svc in api worker migrate; do
  check "(j) no API key in the $svc log" clean_of "$K" "$svc-1" < <(dc logs --no-color "$svc" 2>&1)
done
check "(j) no API key in docker history" clean_of "$K" "docker-entrypoint" < <(docker history --no-trunc "$SMOKE_IMAGE")
check "(j) no API key in the image config" clean_of "$K" "GIT_ASKPASS" < <(docker image inspect "$SMOKE_IMAGE")
in_container_config() { docker inspect "$API_ID" | has "$K"; }
check "(j) the key is in the api container config (by design: compose passes it as an env variable)" \
  in_container_config
check "(j) the api is still healthy and never restarted ($(api_status))" test "$(api_status)" = "healthy restarts=0"

# --- (a) never unhealthy while the worker ran
health_ok() {  # samples exist, healthy ones among them, and never unhealthy while running
  [ -s "$TMP/health.log" ] || return 1
  awk '$2 == "true" && $3 == "healthy"' "$TMP/health.log" | has . || return 1
  ! awk '$2 == "true" && $3 == "unhealthy"' "$TMP/health.log" | has .
}
check "(a) health samples: healthy, and unhealthy never reported while the worker ran" health_ok

echo
if [ "$FAILS" -eq 0 ]; then echo "all smoke steps passed"; else echo "$FAILS smoke step(s) failed"; fi
[ "$FAILS" -eq 0 ]
